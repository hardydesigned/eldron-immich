# Vorlage für eldron/.env je Stufe (Server: /root/eldron-immich-<stufe>). Werte mit <…> ersetzen.
ELDRON_STAGE=<prod|staging>
IMMICH_VERSION=v3.2.2
# prod 2290, staging 2291 – der Caddy des Hosts leitet media(-stg).sentrycommand.com dorthin
HOST_PORT=<2290|2291>
DB_PASSWORD=<secret, nur A-Za-z0-9>
IMMICH_ADMIN_EMAIL=<admin-mail>
IMMICH_ADMIN_PASSWORD=<secret>

HETZNER_BUCKET=<bucket>
HETZNER_S3_ENDPOINT=<endpoint>
HETZNER_S3_REGION=<region>
HETZNER_S3_ACCESS_KEY=<key>
HETZNER_S3_SECRET_KEY=<secret>

# Abgleich mit SentryCommand (leer = kein Abgleich)
# leer = alle Orgs der Clerk-Instanz, sonst kommagetrennte org_…-IDs
SC_ORG_IDS=
SC_SYNC_INTERVAL=900
CONVEX_DEPLOY_KEY=<deploy-key der Convex-Umgebung dieser Stufe>
CLERK_SECRET_KEY=<sk_… der Clerk-Instanz dieser Stufe>
PHOTOMOSAIC_TILE_URL=
